# Copier ce fichier en ".env" et ajuster localement. Ne jamais commiter le ".env" réel.

# "simulated" (par défaut, aucun matériel requis), "hybrid" capteur
# de chaleur réel en 1-Wire direct sur le Pi, pouls et SpO2 simulé ,"i2c" ou "serial" 
# (ANCIENS contrats, obsolètes, abandonnés faute d'avoir pu mettre l'I2C en place côté infra).
SENSOR_SOURCE=simulated

# Utilisé seulement si SENSOR_SOURCE=hybrid. Optionnel : identifiant exact du capteur 1-Wire
# (visible avec `ls /sys/bus/w1/devices/` sur le Pi une fois branché). Laisser vide pour une
# auto-détection (suffisant avec un seul capteur 1-Wire).
ONEWIRE_DEVICE_ID=

# Utilisé seulement si SENSOR_SOURCE=i2c. 1 = bus I2C standard sur Raspberry Pi.
I2C_BUS_NUMBER=1

# Utilisé seulement si SENSOR_SOURCE=serial ou hybrid_serial. Exemples :
#   Linux/Raspberry Pi : /dev/ttyUSB0 ou /dev/ttyACM0
#   Windows             : COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200

# Nom du modèle Ollama créé avec "ollama create medical_box -f models/Modelfile".
OLLAMA_MODEL=medical_box

# Chemin de la base SQLite (créée automatiquement au premier lancement)
DB_PATH=data/kit.db
